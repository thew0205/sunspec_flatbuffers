{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "testToRun",
            "type": "pickString",
            "description": "The test to be run",
            "options": [
                "sunspec_point_reader",
                "sunspec_group_reader",
                "sunspec_model_reader",
                "sunspec_init_writer",
                "sunspec_device_reader",
                "flatbuffer",
                "sunspec_set_value_writer",
                "pzem_temp"
            ],
            "default": "sunspec_init"
        },
        {
            "id": "piPicoChip",
            "type": "pickString",
            "description": "The pico chip you are using",
            "options": [
                "rp2040",
                "rp2350",
            ],
            "default": "rp2040"
        },
        {
            "id": "piPicoChipUpperCase",
            "type": "pickString",
            "description": "The pico chip you are using",
            "options": [
                "RP2040",
                "RP2350",
            ],
            "default": "RP2040"
        }
    ],
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/host/${input:testToRun}/${input:testToRun}_test",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Host Test Build"
        },
        {
            "name": "Pico (Cortex-Debug)",
            "cwd": "${userHome}/.pico-sdk/openocd/0.12.0+dev/scripts",
            "executable": "${workspaceFolder}/build/tests/target/${input:testToRun}/${input:testToRun}_test.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${userHome}/.pico-sdk/openocd/0.12.0+dev/openocd",
            "gdbPath": "${userHome}/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-gdb",
            "device": "${input:piPicoChipUpperCase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${input:piPicoChip}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.2.0/src/${input:piPicoChip}/hardware_regs/${input:piPicoChipUpperCase}.svd",
            "runToEntryPoint": "main",
            // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
            // Also works fine for flash binaries
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${workspaceFolder}/build/tests/target/${input:testToRun}/${input:testToRun}_test.elf\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "showDevDebugOutput": "raw",
            "preLaunchTask": "Target Test Build"
        }
    ]
}